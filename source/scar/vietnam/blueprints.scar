-- Private blueprint identity is resolved in the owning archive. Do not compare
-- its display/short name with an unqualified string to decide gameplay.
VietnamBlueprints = {entities = {}}
local prefix = "813ebcc27f314db9aa5863aeba21c2cc:"

function VietnamBlueprints_Entity(name)
    local blueprint = VietnamBlueprints.entities[name]
    if blueprint == nil then
        blueprint = BP_GetEntityBlueprint(prefix .. name)
        VietnamBlueprints.entities[name] = blueprint
        print("VIETNAM_V2_BP key=" .. name .. " resolved=" .. BP_GetName(blueprint))
    end
    return blueprint
end

function VietnamBlueprints_Matches(entity, name)
    return Entity_GetBlueprint(entity) == VietnamBlueprints_Entity(name)
end
