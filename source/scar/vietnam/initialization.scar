-- Direct native ArmyBP start. No legacy chooser or donor conversion.
VietnamInitializationState = {applied={}}
local PREFIX="813ebcc27f314db9aa5863aeba21c2cc:"
function VietnamInitialization_Apply(player)
    if player == nil or not player.isHuman or not Player_IsAlive(player.id)
      or Player_GetRaceName(player.id) ~= "813ebcc27f314db9aa5863aeba21c2cc:vietnam" then return false,"ineligible-player",false end
    if VietnamInitializationState.applied[player.index] then return true,"already-applied",false end
    for _,age in ipairs({"feudal_age","castle_age","imperial_age"}) do
        if Player_HasUpgrade(player.id,BP_GetUpgradeBlueprint(age)) then return false,"unsupported-age",false end
    end
    local capitals,workers,scouts,buffalos=0,0,0,0
    local workerEntities={}
    local capital=BP_GetEntityBlueprint(PREFIX.."vn_building_town_center_capital_chi")
    local entities=EGroup_CreateUnique()
    Player_GetEntitiesEGroup(player.id,entities)
    for i=1,EGroup_CountSpawned(entities) do
        local entity=EGroup_GetSpawnedEntityAt(entities,i)
        if Entity_GetBlueprint(entity)==capital then capitals=capitals+1 end
    end
    EGroup_Destroy(entities)
    local worker=BP_GetSquadBlueprint(PREFIX.."vn_unit_villager_1_chi")
    local scout=BP_GetSquadBlueprint("813ebcc27f314db9aa5863aeba21c2cc:vn_unit_scout_1_chi")
    local squads=Player_GetSquads(player.id) -- borrowed engine group
    for i=1,SGroup_CountSpawned(squads) do
        local squad=SGroup_GetSpawnedSquadAt(squads,i)
        local bp=Squad_GetBlueprint(squad)
        if bp==worker then
            workers=workers+1;table.insert(workerEntities,Squad_GetFirstEntity(squad))
        elseif bp==scout then scouts=scouts+1 end
        if BP_GetName(bp)=="vn_unit_water_buffalo_vit" then buffalos=buffalos+1 end
    end
    if capitals~=1 or workers~=6 or scouts~=1 or buffalos~=1 then
        print("VIETNAM_NATIVE_START_REJECT unsupported-starting-army")
        return false,"unsupported-starting-army",false
    end

    local ability=BP_GetAbilityBlueprint(PREFIX.."vn_activate_stealth_forvills_vit")
    for _,entity in ipairs(workerEntities) do
        Entity_SetStateModelBool(entity,"is_in_stealth_aura_mal",false)
        if not Entity_HasAbility(entity,ability) then Entity_AddAbility(entity,ability) end
    end

    VietnamInitializationState.applied[player.index]=true
    print("VIETNAM_NATIVE_START_APPLIED capital=1 villagers=6 scout=1")
    return true,"direct-native-start",false
end
